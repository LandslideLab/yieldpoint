{
  "name": "yieldpoint",
  "version": "0.1.0",
  "description": "Dynamic power handover engine for human-machine collaboration and multi-agent systems. Autonomy as a first-class runtime policy.",
  "keywords": [
    "human-in-the-loop",
    "human-on-the-loop",
    "autonomy",
    "handover",
    "multi-agent",
    "agent",
    "llm",
    "policy",
    "hitl"
  ],
  "license": "MIT",
  "author": "yieldpoint contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LandslideLab/yieldpoint.git"
  },
  "bugs": {
    "url": "https://github.com/LandslideLab/yieldpoint/issues"
  },
  "homepage": "https://github.com/LandslideLab/yieldpoint#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./adapters/langgraph": {
      "import": {
        "types": "./dist/adapters/langgraph.d.mts",
        "default": "./dist/adapters/langgraph.mjs"
      },
      "require": {
        "types": "./dist/adapters/langgraph.d.ts",
        "default": "./dist/adapters/langgraph.js"
      }
    },
    "./adapters/openai-agents": {
      "import": {
        "types": "./dist/adapters/openai-agents.d.mts",
        "default": "./dist/adapters/openai-agents.mjs"
      },
      "require": {
        "types": "./dist/adapters/openai-agents.d.ts",
        "default": "./dist/adapters/openai-agents.js"
      }
    },
    "./adapters/vercel-ai-sdk": {
      "import": {
        "types": "./dist/adapters/vercel-ai-sdk.d.mts",
        "default": "./dist/adapters/vercel-ai-sdk.mjs"
      },
      "require": {
        "types": "./dist/adapters/vercel-ai-sdk.d.ts",
        "default": "./dist/adapters/vercel-ai-sdk.js"
      }
    },
    "./adapters/agent-loop": {
      "import": {
        "types": "./dist/adapters/agent-loop.d.mts",
        "default": "./dist/adapters/agent-loop.mjs"
      },
      "require": {
        "types": "./dist/adapters/agent-loop.d.ts",
        "default": "./dist/adapters/agent-loop.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "tsx demo/medical-assistant.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
